task.spawn(function()
	local backpack = player:WaitForChild("Backpack")
	local useFirst = true

	while true do
		task.wait(3)

		local ok, err = pcall(function()
			if useFirst then
				local tool = backpack:GetChildren()[2]
				if tool and tool:FindFirstChild("abilityEvent") then
					tool.abilityEvent:FireServer()
				end
			else
				local tool = backpack:GetChildren()[1]
				if tool and tool:FindFirstChild("abilityEvent") then
