local REACH_DISTANCE = 4
local STUCK_TIMEOUT = 8
local MAX_TOTAL_TIME = 2400
local UPDATE_INTERVAL = 0.1

local function walkTo(target)
	local lastPos = rootPart.Position
	local lastProgressTime = os.clock()

	while true do
		if not character.Parent or not humanoid.Parent or humanoid.Health <= 0 then
			return false, "died"
		end

		local currentPos = rootPart.Position
		local distance = (Vector3.new(currentPos.X, 0, currentPos.Z) 
		                 - Vector3.new(target.X, 0, target.Z)).Magnitude

		if distance <= REACH_DISTANCE then
			humanoid:MoveTo(currentPos)
			return true
		end

		if (currentPos - lastPos).Magnitude > 1 then
			lastPos = currentPos
			lastProgressTime = os.clock()
		elseif os.clock() - lastProgressTime > STUCK_TIMEOUT then
			humanoid:MoveTo(currentPos)
			return false, "stuck"
		end

		humanoid:MoveTo(target)
		task.wait(UPDATE_INTERVAL)
	end
end

local runStart = os.clock()
for i, pos in ipairs(waypoints) do
	if os.clock() - runStart > MAX_TOTAL_TIME then
		warn("[WaypointWalker] Max total time reached, stopping.")
		break
	end

	print(string.format("[WaypointWalker] Walking to #%d: %s", i, tostring(pos)))
	local ok, reason = walkTo(pos)

	if ok then
		print(string.format("[WaypointWalker] Reached #%d", i))
	else
		warn(string.format("[WaypointWalker] Failed to reach #%d (%s)", i, reason or "unknown"))
		if reason == "died" then break end
	end
end

print("[WaypointWalker] Done.")
