local LOOKAHEAD       = 6
local REACH_DISTANCE  = 3
local STUCK_TIMEOUT   = 8
local MAX_TOTAL_TIME  = 2400
local UPDATE_INTERVAL = 0.05
local IGNORE_Y        = false

local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

local function refreshCharacter()
	character = player.Character or player.CharacterAdded:Wait()
	humanoid  = character:WaitForChild("Humanoid")
	rootPart  = character:WaitForChild("HumanoidRootPart")
end

local function getPos(wp)
	if typeof(wp) == "Vector3" then return wp end
	if type(wp) == "table" and wp.pos then return wp.pos end
	return nil
end

local function fireEvent(key)
	if key == "q" then
		local ok, err = pcall(function()
			player.Backpack:GetChildren()[1].abilityEvent:FireServer()
		end)
		if not ok then warn("[Player] Q failed: " .. tostring(err)) end
	elseif key == "e" then
		local ok, err = pcall(function()
			player.Backpack:GetChildren()[2].spellEvent:FireServer()
		end)
		if not ok then warn("[Player] E failed: " .. tostring(err)) end
	end
end

local function walkToIndex(i)
	local wp    = WAYPOINTS[i]
	local wpPos = getPos(wp)
	if not wpPos then return true end

	local lookIdx = math.min(i + LOOKAHEAD, #WAYPOINTS)
	local lookPos = getPos(WAYPOINTS[lookIdx]) or wpPos

	local lastPos = rootPart.Position
	local lastProgressTime = os.clock()

	while true do
		if not character.Parent or not humanoid.Parent or humanoid.Health <= 0 then
			return false
		end

		humanoid:MoveTo(lookPos)

		local currentPos = rootPart.Position
		local a, b = currentPos, wpPos
		if IGNORE_Y then
			a = Vector3.new(currentPos.X, 0, currentPos.Z)
			b = Vector3.new(wpPos.X, 0, wpPos.Z)
		end

		if (a - b).Magnitude <= REACH_DISTANCE then
			return true
		end

		if (currentPos - lastPos).Magnitude > 1 then
			lastPos = currentPos
			lastProgressTime = os.clock()
		elseif os.clock() - lastProgressTime > STUCK_TIMEOUT then
			return false, "stuck"
		end

		task.wait(UPDATE_INTERVAL)
	end
end

if #WAYPOINTS == 0 then
	warn("[PathPlayer] WAYPOINTS is empty.")
	return
end

task.spawn(function()
	local runStart = os.clock()

	for i, wp in ipairs(WAYPOINTS) do
		if os.clock() - runStart > MAX_TOTAL_TIME then
			warn("[PathPlayer] Max total time reached, stopping.")
			break
		end

		local ok, reason = walkToIndex(i)

		if not ok then
			if reason == "stuck" then
				warn(string.format("[PathPlayer] Stuck at #%d, skipping.", i))
			else
				warn(string.format("[PathPlayer] Character lost at #%d. Reacquiring...", i))
				task.wait(1)
				refreshCharacter()
				continue
			end
		end

		local elapsed = 0
		if wp.events and #wp.events > 0 then
			table.sort(wp.events, function(a, b) return a.at < b.at end)
			for _, ev in ipairs(wp.events) do
				local dt = ev.at - elapsed
				if dt > 0 then
					task.wait(dt)
					elapsed = elapsed + dt
				end
				fireEvent(ev.key)
			end
		end

		local remaining = (wp.wait or 0) - elapsed
		if remaining > 0 then
			humanoid:MoveTo(rootPart.Position)
			task.wait(remaining)
		end
	end

	if humanoid and humanoid.Parent then
		humanoid:MoveTo(rootPart.Position)
	end

	print("[PathPlayer] Reached the end of the path.")
end)
