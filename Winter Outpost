local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

do
	local startEvent = game:GetService("ReplicatedStorage").remotes.changeStartValue
	local ok, err = pcall(function()
		startEvent:FireServer()
	end)
	if not ok then
		warn("[StartEvent] Failed to fire: " .. tostring(err))
	end
end

task.spawn(function()
	local backpack = player:WaitForChild("Backpack")
	local useFirst = true

	while true do
		task.wait(3)

		local ok, err = pcall(function()
			if useFirst then
				local tool = backpack:GetChildren()[2]
				if tool and tool:FindFirstChild("abilityEvent") then
					tool.abilityEvent:FireServer()
				end
			else
				local tool = backpack:GetChildren()[1]
				if tool and tool:FindFirstChild("abilityEvent") then
					tool.abilityEvent:FireServer()
				end
			end
		end)

		if not ok then
			warn("[AbilityLoop] " .. tostring(err))
		end

		useFirst = not useFirst
	end
end)

task.wait(4.5)

