local REACH_DISTANCE = 3       -- How close (studs) counts as "reached"
local STUCK_TIMEOUT = 8        -- Seconds without progress before retrying MoveTo
local MAX_TOTAL_TIME = 2400    -- Safety cap for whole run
local UPDATE_INTERVAL = 0.05   -- Poll interval while walking
local IGNORE_Y = false         -- true = compare only X/Z distance
local YAW_RESPONSIVENESS = 200

-- ---------------------------------------------------------------------
-- SYNC SETTINGS
-- ---------------------------------------------------------------------
-- Put EVERY username that runs this script here (yours can be in the
-- list too, it is skipped automatically). Each client watches the others'
-- characters to know how far along the path they are.
local SYNC_PLAYERS = REQUIRED_PLAYERS

local SYNC_WAIT_THRESHOLD = 0.5 -- any waypoint with wait >= this is a sync point
local SYNC_ON_EVENTS      = false -- true = also stop before every Q / E (makes walking stop-and-go)
local SYNC_RADIUS         = 6    -- studs: "standing at the point" for a peer
local MAX_LEAD            = 30   -- waypoints: only pause if you get this far ahead of the slowest peer
local RESUME_LEAD         = 12   -- ...and keep holding until they are within this many (no stop/go flicker)
local LEAD_CHECK_INTERVAL = 0.25 -- seconds between lead checks (not every waypoint)
local SYNC_TIMEOUT        = 30   -- seconds: give up on a peer that never shows up
local SYNC_POLL           = 0.1
local TRACK_WINDOW        = 60   -- waypoints searched ahead when locating a peer on the path
local TRACK_MAX_DIST      = 30   -- studs: peer further than this from the path = can't locate

local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

-- Yaw control (physics-friendly, position-safe)
local yawAttachment
local alignOrientation
local currentYaw = 0

local function setupYawControl()
	humanoid.AutoRotate = false

	if alignOrientation then alignOrientation:Destroy() end
	if yawAttachment then yawAttachment:Destroy() end

	yawAttachment = Instance.new("Attachment")
	yawAttachment.Name = "YawLockAttachment"
	yawAttachment.Parent = rootPart

	alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "YawLockAlign"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = yawAttachment
	alignOrientation.CFrame = CFrame.Angles(0, math.rad(currentYaw), 0)
	alignOrientation.MaxTorque = math.huge
	alignOrientation.Responsiveness = YAW_RESPONSIVENESS
	alignOrientation.RigidityEnabled = false
	alignOrientation.Parent = rootPart
end

local function refreshCharacter()
	character = player.Character or player.CharacterAdded:Wait()
	humanoid  = character:WaitForChild("Humanoid")
	rootPart  = character:WaitForChild("HumanoidRootPart")
	setupYawControl()
end

setupYawControl()

local function getPos(wp)
	if typeof(wp) == "Vector3" then
		return wp
	elseif type(wp) == "table" and wp.pos then
		return wp.pos
	end
	return nil
end

local function fireEvent(key)
	if key == "q" then
		local ok, err = pcall(function()
			local Event = player.Backpack:GetChildren()[1].abilityEvent
			Event:FireServer()
		end)
		if not ok then warn("[Player] Q failed: " .. tostring(err)) end

	elseif key == "e" then
		local ok, err = pcall(function()
			local backpack = player.Backpack
			local Event

			if player.Name:lower() == "tewf4vz" then
				Event = backpack["Blade Barrage"].abilityEvent
				Event:FireServer()
			else
				Event = backpack:GetChildren()[2].spellEvent
				Event:FireServer()
			end
		end)
		if not ok then warn("[Player] E failed: " .. tostring(err)) end
	end
end

local function faceYaw(yaw)
	currentYaw = yaw
	if alignOrientation and alignOrientation.Parent then
		alignOrientation.CFrame = CFrame.Angles(0, math.rad(yaw), 0)
	end
end

-- ---------------------------------------------------------------------
-- PEER TRACKING
-- Clients can't talk to each other directly, so each client works out how
-- far along the path every other player is by finding the closest waypoint
-- to their character. The index only ever moves forward, which keeps the
-- places where the path doubles back from confusing it.
-- ---------------------------------------------------------------------
local peerIndex = {}  -- name -> last known waypoint index
local ignoredAt = {}  -- name -> index a timed-out peer was stuck at (ignored until it moves)

local function estimateIndex(name)
	local plr = Players:FindFirstChild(name)
	if not plr then return nil end
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return nil end

	local last = peerIndex[name] or 1
	local pos = hrp.Position

	local function search(from, to)
		local best, bestD = nil, math.huge
		for i = from, to do
			local d = (WAYPOINTS[i].pos - pos).Magnitude
			if d <= bestD then -- "<=" so duplicate points resolve to the later index
				best, bestD = i, d
			end
		end
		return best, bestD
	end

	local best, bestD = search(last, math.min(#WAYPOINTS, last + TRACK_WINDOW))
	if not best or bestD > TRACK_MAX_DIST then
		-- peer jumped far ahead (lag spike / teleport): look at the whole rest of the path
		best, bestD = search(last, #WAYPOINTS)
	end
	if best and bestD <= TRACK_MAX_DIST then
		peerIndex[name] = best
	end
	return peerIndex[name] or 1, hrp
end

-- Peers that are behind waypoint `idx` by more than `slack` waypoints.
-- If `atPos` is given, a peer physically standing within SYNC_RADIUS of it also counts as arrived.
local function getBehind(idx, slack, atPos)
	local behind = {}
	for _, name in ipairs(SYNC_PLAYERS) do
		if name ~= player.Name then
			local pi, hrp = estimateIndex(name)
			if pi and pi < idx - slack then
				local arrived = atPos and (hrp.Position - atPos).Magnitude <= SYNC_RADIUS
				if not arrived then
					if ignoredAt[name] and pi <= ignoredAt[name] then
						-- timed out earlier and still hasn't moved: don't block on them again
					else
						ignoredAt[name] = nil
						table.insert(behind, name)
					end
				end
			end
		end
	end
	return behind
end

local function waitForPeers(idx, slack, atPos, label, releaseSlack)
	local behind = getBehind(idx, slack, atPos)
	if #behind == 0 then return end

	-- stand still while we wait
	if humanoid and humanoid.Parent then
		humanoid:MoveTo(rootPart.Position)
	end

	local t0 = os.clock()
	while true do
		if not character.Parent or humanoid.Health <= 0 then return end
		behind = getBehind(idx, releaseSlack or slack, atPos)
		if #behind == 0 then return end
		if os.clock() - t0 > SYNC_TIMEOUT then
			warn(string.format("[Sync] %s timeout at #%d, waiting on: %s", label, idx, table.concat(behind, ", ")))
			for _, name in ipairs(behind) do
				ignoredAt[name] = peerIndex[name] or 0
			end
			return
		end
		task.wait(SYNC_POLL)
	end
end

-- ---------------------------------------------------------------------
-- WALKING
-- Never gives up on a waypoint just because the client froze for a while;
-- it retries MoveTo and finally moves on while still running the events.
-- Returns nil only if the character is dead / gone.
-- ---------------------------------------------------------------------
local function walkTo(target)
	local lastPos = rootPart.Position
	local lastProgressTime = os.clock()
	local retries = 0

	humanoid:MoveTo(target)

	while true do
		if not character.Parent or not humanoid.Parent or humanoid.Health <= 0 then
			return nil
		end

		local currentPos = rootPart.Position
		local a, b = currentPos, target
		if IGNORE_Y then
			a = Vector3.new(currentPos.X, 0, currentPos.Z)
			b = Vector3.new(target.X, 0, target.Z)
		end

		if (a - b).Magnitude <= REACH_DISTANCE then
			return rootPart
		end

		if (currentPos - lastPos).Magnitude > 1 then
			lastPos = currentPos
			lastProgressTime = os.clock()
			retries = 0
		elseif os.clock() - lastProgressTime > STUCK_TIMEOUT then
			retries += 1
			if retries >= 3 then
				return rootPart -- treat as reached so events/sync still happen
			end
			lastProgressTime = os.clock()
			humanoid.Jump = true
			humanoid:MoveTo(target)
		end

		task.wait(UPDATE_INTERVAL)
	end
end

if #WAYPOINTS == 0 then
	warn("[PathPlayer] WAYPOINTS is empty -- paste your recorded path into the table.")
	return
end

for _, wp in ipairs(WAYPOINTS) do
	if type(wp) == "table" and wp.yaw then
		currentYaw = wp.yaw
		if alignOrientation then
			alignOrientation.CFrame = CFrame.Angles(0, math.rad(currentYaw), 0)
		end
		break
	end
end

task.spawn(function()
	local runStart = os.clock()
	local lastLeadCheck = 0

	for i, wp in ipairs(WAYPOINTS) do
		-- NOTE: the total-time cap only counts time spent actually walking, not sync holds
		if os.clock() - runStart > MAX_TOTAL_TIME then
			warn("[PathPlayer] Max total time reached, stopping.")
			break
		end

		local pos = getPos(wp)
		if not pos then
			warn(string.format("[PathPlayer] Skipping malformed waypoint #%d", i))
			continue
		end

		-- 1) Soft sync: never run more than MAX_LEAD waypoints ahead of the slowest peer
		-- (checked on a timer, so normal walking never pauses between close-together waypoints)
		if os.clock() - lastLeadCheck >= LEAD_CHECK_INTERVAL then
			local t = os.clock()
			waitForPeers(i, MAX_LEAD, nil, "lead", RESUME_LEAD)
			runStart += os.clock() - t
			lastLeadCheck = os.clock()
		end

		local root = walkTo(pos)

		if not root then
			warn(string.format("[PathPlayer] Character lost at #%d. Reacquiring...", i))
			task.wait(1)
			refreshCharacter()
			continue
		end

		if wp.yaw then
			faceYaw(wp.yaw)
		end

		-- 2) Hard sync: at long waits and before ability events, everyone must be AT this point
		local hasEvents = wp.events and #wp.events > 0
		local isLongWait = (wp.wait or 0) >= SYNC_WAIT_THRESHOLD
		if isLongWait or (hasEvents and SYNC_ON_EVENTS) then
			local t2 = os.clock()
			waitForPeers(i, 0, pos, "point")
			runStart += os.clock() - t2
		end

		local elapsed = 0
		if hasEvents then
			table.sort(wp.events, function(a, b) return a.at < b.at end)
			for _, ev in ipairs(wp.events) do
				local dt = ev.at - elapsed
				if dt > 0 then task.wait(dt) end
				elapsed = math.max(elapsed, ev.at)
				fireEvent(ev.key)
			end
		end

		-- the wait is measured from when everyone was released, so all clients wait together
		local remaining = (wp.wait or 0) - elapsed
		if remaining > 0 then
			task.wait(remaining)
		end
	end

	if humanoid and humanoid.Parent then
		humanoid:MoveTo(rootPart.Position)
	end

	print("[PathPlayer] Reached the end of the path.")
end)

local firedForCharacter = nil

local function fireReplayDungeon()
	local Event = game:GetService("ReplicatedStorage").remotes.replayDungeon
	local ok, err = pcall(function()
		Event:FireServer({
			dungeonProgress = "finished",
			dungeonStarted = true,
			dungeonFinished = true,
			hardcore = true,
			dungeonName = "Enchanted Forest",
			isHardcore = true,
			fightingBoss = false
		})
	end)
	if not ok then
		warn("[DeathReplay] Failed to fire replayDungeon: " .. tostring(err))
	end
end

local function hookDeath(char)
	if not char or firedForCharacter == char then return end
	firedForCharacter = char

	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end

	hum.Died:Connect(function()
		fireReplayDungeon()
	end)
end

hookDeath(character)
player.CharacterAdded:Connect(hookDeath)
