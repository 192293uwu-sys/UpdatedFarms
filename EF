task.wait(1)

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local WALK_TARGET = Vector3.new(50, 5, -50) -- ground level position
local ARRIVE_RADIUS = 6 -- studs — the "close enough" detection
local REQUIRED_PLAYERS = {"tewf4vz" } -- every username running this script
if not table.find(REQUIRED_PLAYERS, player.Name) then
	table.insert(REQUIRED_PLAYERS, player.Name)
end

local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

-- Flag: set true once both players are detected at the target.
-- The walk thread checks this and stops issuing MoveTo.
local walkDone = false

local function walkToTarget()
	task.spawn(function()
		while not walkDone and root.Parent and humanoid.Health > 0 do
			local flatTarget = Vector3.new(WALK_TARGET.X, root.Position.Y, WALK_TARGET.Z)
			local flatPos    = Vector3.new(root.Position.X,    root.Position.Y, root.Position.Z)

			-- Only push toward the target if we're outside the stud radius.
			if (flatTarget - flatPos).Magnitude > ARRIVE_RADIUS then
				humanoid:MoveTo(WALK_TARGET)
			end

			task.wait(0.2)
		end
	end)
end

local function isPlayerAtTarget(username)
	local plr = Players:FindFirstChild(username)
	if not plr or not plr.Character then return false end

	local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return false end

	local flatTarget = Vector3.new(WALK_TARGET.X, hrp.Position.Y, WALK_TARGET.Z)
	return (flatTarget - hrp.Position).Magnitude <= ARRIVE_RADIUS
end

walkToTarget()

while true do
	local allReady = true
	for _, name in ipairs(REQUIRED_PLAYERS) do
		if not isPlayerAtTarget(name) then
			allReady = false
			break
		end
	end
	if allReady then break end
	task.wait(0.25)
end

walkDone = true

do
	local startEvent = game:GetService("ReplicatedStorage").remotes.changeStartValue
	local ok, err = pcall(function()
		startEvent:FireServer()
	end)
	if not ok then
		warn("[StartEvent] Failed to fire: " .. tostring(err))
	end
end

