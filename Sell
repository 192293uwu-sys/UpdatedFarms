        ID_TO_CATEGORY[id] = category
    end
end

local function getAssetId(imageStr)
    if not imageStr then return nil end
    return string.match(imageStr, "%d+")
end

local function getImageColorFromSlot(slot)
    local success, result = pcall(function() return slot.ImageColor3 end)
    if success and result then return result end
    
    for _, desc in ipairs(slot:GetDescendants()) do
        local ok, col = pcall(function() return desc.ImageColor3 end)
        if ok and col then return col end
    end
    
    for _, child in ipairs(slot:GetChildren()) do
        local ok, col = pcall(function() return child.ImageColor3 end)
        if ok and col then return col end
    end
    
    return nil
end

local function getRarityName(color3)
    if not color3 then return nil end
    local r = math.round(color3.R * 255)
    local g = math.round(color3.G * 255)
    local b = math.round(color3.B * 255)
    
    for _, entry in ipairs(RARITY_COLORS) do
        local tr, tg, tb = entry.color[1], entry.color[2], entry.color[3]
        if math.abs(r - tr) <= 3 and math.abs(g - tg) <= 3 and math.abs(b - tb) <= 3 then
            return entry.name
        end
    end
    return nil
end

local function scanAndSell()
    
    local playerGui = player:FindFirstChild("PlayerGui")
    local sellShop = playerGui and playerGui:FindFirstChild("sellShop")
    if not sellShop then 
        return 
    end
    
    local frame = sellShop:FindFirstChild("Frame")
    local innerFrame = frame and frame:FindFirstChild("innerFrame")
    local rightSideFrame = innerFrame and innerFrame:FindFirstChild("rightSideFrame")
    local scrollingFrame = rightSideFrame and rightSideFrame:FindFirstChild("ScrollingFrame")
    
    if not scrollingFrame then
        return
    end

    local dungeonNameObj = workspace:FindFirstChild("dungeonName")
    local isInDungeon = false
    if dungeonNameObj and dungeonNameObj:IsA("ValueBase") and dungeonNameObj.Value ~= "" then
        isInDungeon = true
    else
    end


    local sellData = { helmet = {}, ability = {}, chest = {}, weapon = {} }
    local toSellCount = 0
    local slotsChecked = 0

    for _, slot in ipairs(scrollingFrame:GetChildren()) do
        if slot:IsA("GuiObject") then
            slotsChecked = slotsChecked + 1
            
            local filler = slot:FindFirstChild("filler")
            local itemImage = filler and filler:FindFirstChild("itemImage") or slot:FindFirstChild("itemImage")
            
            if itemImage and itemImage:IsA("ImageLabel") then
                local assetId = getAssetId(itemImage.Image)
                
                if assetId then
                    local category = ID_TO_CATEGORY[assetId]
                    local isKeep = false
                    
                    local itemTypeObj = slot:FindFirstChild("itemType")
                    local rarityName = nil
                    
                    if itemTypeObj then
                        local rarityObj = itemTypeObj:FindFirstChild("rarity")
                        if rarityObj and rarityObj:IsA("StringValue") and rarityObj.Value ~= "" then
                            local val = string.lower(rarityObj.Value)
                            if val == "ult" or val == "ultimate" then rarityName = "Ult"
                            elseif val == "legendary" then rarityName = "Legendary"
                            elseif val == "epic" then rarityName = "Epic"
                            elseif val == "rare" then rarityName = "Rare"
                            elseif val == "uncommon" then rarityName = "Uncommon"
                            elseif val == "common" then rarityName = "Common"
                            else rarityName = rarityObj.Value end
                        end
                    end

                    if not rarityName then
                        local slotColor = getImageColorFromSlot(slot)
                        rarityName = getRarityName(slotColor)
                    end

                    if rarityName == "Legendary" or rarityName == "Ult" then
                        isKeep = true
                    elseif rarityName then
                        if category then
                            local allowedRarities = RARITY_CONFIG[category] or DEFAULT_RARITIES
                            if allowedRarities[rarityName] then
                                isKeep = true
                            end
                        elseif rarityName == "Epic" then
                            isKeep = false
                        end
                    end

                    if not isKeep then
                        if itemTypeObj then
                            local itemType = itemTypeObj.Value
                            local uniqueNumObj = itemTypeObj:FindFirstChild("uniqueItemNum")
                            if not uniqueNumObj then uniqueNumObj = slot:FindFirstChild("uniqueItemNum") end
                            
                            local uniqueIdObj = itemTypeObj:FindFirstChild("uniqueItemId")
                            if not uniqueIdObj then uniqueIdObj = slot:FindFirstChild("uniqueItemId") end

                            local formattedString = nil
                            
                            if isInDungeon then
                                if uniqueNumObj then
                                    formattedString = tostring(uniqueNumObj.Value)
                                end
                            else
                                if uniqueNumObj and uniqueIdObj then
                                    formattedString = tostring(uniqueNumObj.Value) .. ":" .. tostring(uniqueIdObj.Value)
                                end
                            end

                            if formattedString then
                                if not sellData[itemType] then sellData[itemType] = {} end
                                table.insert(sellData[itemType], formattedString)
                                toSellCount = toSellCount + 1
                            else
                            end
                        end
                    end
                end
            end
        end
    end

    if toSellCount > 0 then
        for cat, items in pairs(sellData) do
            if #items > 0 then
                print("[" .. cat .. "]:")
                for _, item in ipairs(items) do
                    print("  - " .. item)
                end
            end
        end
    else
    end

    local openSellShop = ReplicatedStorage:FindFirstChild("remotes") and ReplicatedStorage.remotes:FindFirstChild("openSellShop")
    if openSellShop and firesignal then
        local success, err = pcall(function()
            firesignal(openSellShop.OnClientEvent)
        end)
        if success then
        else
        end
    else
    end

    if sellShop then
        sellShop.Enabled = false
    end

    if not DRY_RUN then
        if toSellCount > 0 then
            local sellEvent = ReplicatedStorage:FindFirstChild("remotes") and ReplicatedStorage.remotes:FindFirstChild("sellItemEvent")
            if sellEvent then
                sellEvent:FireServer(sellData)
            else
            end
        end
    else
    end
end

